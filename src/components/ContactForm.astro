---
---

<section id="contact" class="py-20 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left: Direct Channels -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Live Status Card -->
        <div class="glass-card p-5 rounded-2xl border border-indigo-500/30 bg-indigo-950/20 flex items-center justify-between shadow-xl">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></div>
            <div>
              <span class="text-xs font-mono text-indigo-300 block">Direct Inquiries</span>
              <span class="text-sm font-bold text-white">Available Day & Night</span>
            </div>
          </div>
          <span class="text-xs font-mono text-emerald-400 font-semibold">Active Now</span>
        </div>

        <!-- Direct Email Card -->
        <a href="mailto:contact@sanjeevchoudhary.com" class="glass-card p-5 rounded-2xl border border-slate-800 hover:border-indigo-500/50 flex items-center gap-4 group transition-all">
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div class="flex-1 min-w-0">
            <span class="text-xs text-slate-400 block font-mono">Official Email</span>
            <h4 class="text-base font-bold text-white group-hover:text-indigo-400 transition-colors truncate">contact@sanjeevchoudhary.com</h4>
            <span class="text-xs text-indigo-400">All project details received here</span>
          </div>
        </a>

        <!-- WhatsApp Direct -->
        <a href="https://wa.me/37254587576" target="_blank" rel="noopener" class="glass-card p-5 rounded-2xl border border-slate-800 hover:border-emerald-500/50 flex items-center gap-4 group transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
            <i class="fa-brands fa-whatsapp"></i>
          </div>
          <div>
            <span class="text-xs text-slate-400 block font-mono">Direct WhatsApp</span>
            <h4 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors">+372 5458 7576</h4>
            <span class="text-xs text-emerald-400">Instant chat • Replies in &lt;15 mins</span>
          </div>
        </a>

        <!-- Upwork Profile -->
        <a href="https://www.upwork.com/freelancers/~01ce3c687db283151d" target="_blank" rel="noopener" class="glass-card p-5 rounded-2xl border border-slate-800 hover:border-emerald-500/50 flex items-center gap-4 group transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
            <i class="fa-brands fa-upwork"></i>
          </div>
          <div>
            <span class="text-xs text-slate-400 block font-mono">Escrow Protected</span>
            <h4 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors">Hire on Upwork</h4>
            <span class="text-xs text-slate-400">100% Job Success Score</span>
          </div>
        </a>

        <!-- Fiverr Profile -->
        <a href="https://www.fiverr.com/sanju28" target="_blank" rel="noopener" class="glass-card p-5 rounded-2xl border border-slate-800 hover:border-emerald-500/50 flex items-center gap-4 group transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <div>
            <span class="text-xs text-slate-400 block font-mono">Top Rated Seller</span>
            <h4 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors">Hire on Fiverr (@sanju28)</h4>
            <span class="text-xs text-amber-400">5.0 Star Rating</span>
          </div>
        </a>
      </div>

      <!-- Right: Send Message Form -->
      <div class="lg:col-span-7">
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800 shadow-2xl relative">
          <h3 class="text-2xl font-bold text-white mb-2">Send Project Brief</h3>
          <p class="text-xs text-slate-400 mb-6">
            All details will be sent directly to <strong class="text-indigo-400">contact@sanjeevchoudhary.com</strong>. I reply within a few hours.
          </p>

          <form 
            id="contact-form" 
            action="https://formsubmit.co/contact@sanjeevchoudhary.com" 
            method="POST" 
            class="space-y-4"
          >
            <!-- FormSubmit Configuration -->
            <input type="hidden" name="_subject" value="New Client Inquiry from SanjeevChoudhary.com">
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_template" value="table">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Your Name *</label>
                <input type="text" name="name" required placeholder="John Doe" class="w-full bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Your Email *</label>
                <input type="email" name="email" required placeholder="john@example.com" class="w-full bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Your Phone / WhatsApp</label>
                <input type="text" name="phone" placeholder="+1 234 567 8900" class="w-full bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Service Required</label>
                <select name="service" class="w-full bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
                  <option>WordPress / Elementor Pro Custom Build</option>
                  <option>Shopify 2.0 Store Setup & Liquid Theme</option>
                  <option>On-Page & Off-Page SEO Growth Package</option>
                  <option>Keyword Research & Rank Strategy</option>
                  <option>Speed Optimization & Core Web Vitals 95+</option>
                  <option>WooCommerce E-Commerce Store</option>
                  <option>Custom PHP & REST API Integration</option>
                  <option>Emergency Bug Fix / Malware Removal</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1.5">Project Scope & Details *</label>
              <textarea name="message" rows="4" required placeholder="Briefly describe your requirements, reference URLs, deadline, and estimated budget..." class="w-full bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors"></textarea>
            </div>

            <button type="submit" id="submit-btn" class="w-full py-4 rounded-xl bg-gradient-to-r from-indigo-500 via-indigo-600 to-cyan-500 text-white font-bold text-sm shadow-xl shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer">
              <i class="fa-solid fa-paper-plane text-xs"></i> Send to contact@sanjeevchoudhary.com
            </button>
          </form>

          <!-- Dynamic Status Message -->
          <div id="form-status" class="hidden mt-4 p-4 rounded-xl text-xs font-medium"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function initContactForm() {
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');

    if (!form || !status) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i> Sending to contact@sanjeevchoudhary.com...';

      try {
        const formData = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (res.ok) {
          status.className = 'mt-4 p-4 rounded-xl text-xs font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 block';
          status.innerHTML = '<i class="fa-solid fa-circle-check mr-1.5"></i> Thank you! Your project details have been successfully sent to <strong>contact@sanjeevchoudhary.com</strong>. Sanjeev will get back to you shortly.';
          form.reset();
        } else {
          // Fallback to mailto if FormSubmit had an issue
          window.location.href = 'mailto:contact@sanjeevchoudhary.com?subject=Project Inquiry&body=' + encodeURIComponent('Please check my inquiry.');
          status.className = 'mt-4 p-4 rounded-xl text-xs font-medium bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 block';
          status.innerHTML = 'Opening email client to send directly to contact@sanjeevchoudhary.com...';
        }
      } catch (err) {
        window.location.href = 'mailto:contact@sanjeevchoudhary.com?subject=Project Inquiry&body=' + encodeURIComponent('Please check my inquiry.');
        status.className = 'mt-4 p-4 rounded-xl text-xs font-medium bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 block';
        status.innerHTML = 'Email client opened for contact@sanjeevchoudhary.com.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  })();
</script>
