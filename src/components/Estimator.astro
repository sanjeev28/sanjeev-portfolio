---
---

<section id="estimator" class="py-20 relative z-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Instant Calculation
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Transparent Project Cost Estimator
      </h2>
      <p class="text-slate-400 text-sm max-w-xl mx-auto mt-2">
        Get an immediate ballpark quotation tailored to your web development & SEO requirements.
      </p>
    </div>

    <div class="glass-card rounded-3xl p-8 sm:p-12 border border-slate-800 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center shadow-2xl">
      <div class="lg:col-span-7 space-y-6">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Select Platform & Project Type</label>
          <select id="calc-type" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
            <option value="shopify">Shopify 2.0 Store Setup & Custom Liquid Theme ($380)</option>
            <option value="elementor" selected>Elementor Pro Custom Design & Responsive Build ($220)</option>
            <option value="divi">Divi Custom Layout & Module Setup ($240)</option>
            <option value="landing">High-Conversion Landing Page ($120)</option>
            <option value="custom_wp">Complete Custom WordPress Theme & CMS ($450)</option>
            <option value="ecommerce">Full WooCommerce E-Commerce Store ($550)</option>
            <option value="seo_campaign">Complete SEO Growth Package (On-Page, Off-Page & Keywords) ($280)</option>
            <option value="speed">Speed & Core Web Vitals 95+ Tuning ($150)</option>
          </select>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Estimated Number of Pages / Target Keywords</label>
            <span class="text-sm font-bold font-mono text-cyan-400"><span id="calc-pages-val">5</span> Pages</span>
          </div>
          <input type="range" id="calc-pages" min="1" max="15" value="5" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer">
        </div>

        <div class="pt-2 space-y-3">
          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
            <input type="checkbox" id="calc-speed" checked class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
            <span class="text-xs sm:text-sm text-slate-300 flex-1">95+ PageSpeed & Core Web Vitals Optimization</span>
            <span class="text-xs font-mono text-emerald-400">+$80</span>
          </label>

          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
            <input type="checkbox" id="calc-seo" checked class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
            <span class="text-xs sm:text-sm text-slate-300 flex-1">On-Page Technical SEO & Schema Markup</span>
            <span class="text-xs font-mono text-emerald-400">+$60</span>
          </label>

          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
            <input type="checkbox" id="calc-keyword" class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
            <span class="text-xs sm:text-sm text-slate-300 flex-1">In-Depth Keyword Research & Competitor Gap Analysis</span>
            <span class="text-xs font-mono text-emerald-400">+$90</span>
          </label>

          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
            <input type="checkbox" id="calc-offpage" class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
            <span class="text-xs sm:text-sm text-slate-300 flex-1">Off-Page SEO Backlink Outreach & Authority Citations</span>
            <span class="text-xs font-mono text-emerald-400">+$120</span>
          </label>
        </div>
      </div>

      <div class="lg:col-span-5 bg-gradient-to-tr from-slate-900 via-indigo-950/60 to-slate-900 p-8 rounded-2xl border border-indigo-500/30 text-center">
        <span class="px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-mono inline-block mb-3">Estimated Investment</span>
        <div id="calc-cost" class="text-5xl font-extrabold text-white font-mono tracking-tight mb-1">$480</div>
        <span class="text-xs text-slate-400 mb-6 block">One-time transparent quote</span>

        <div class="grid grid-cols-2 gap-3 mb-6 text-left">
          <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
            <span class="text-[10px] font-mono text-slate-500 block uppercase">Est. Delivery</span>
            <span id="calc-days" class="text-sm font-bold text-white font-mono">7 Days</span>
          </div>
          <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
            <span class="text-[10px] font-mono text-slate-500 block uppercase">Support</span>
            <span class="text-sm font-bold text-emerald-400 font-mono">30 Days Free</span>
          </div>
        </div>

        <a id="calc-whatsapp-btn" href="https://wa.me/37254587576" target="_blank" rel="noopener" class="w-full py-3.5 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/25 transition-all">
          <i class="fa-brands fa-whatsapp text-lg"></i> Lock In This Quote
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function initEstimator() {
    const typeSelect = document.getElementById('calc-type');
    const pagesRange = document.getElementById('calc-pages');
    const pagesVal = document.getElementById('calc-pages-val');
    const speedCheck = document.getElementById('calc-speed');
    const seoCheck = document.getElementById('calc-seo');
    const keywordCheck = document.getElementById('calc-keyword');
    const offpageCheck = document.getElementById('calc-offpage');
    const costDisplay = document.getElementById('calc-cost');
    const daysDisplay = document.getElementById('calc-days');
    const whatsappBtn = document.getElementById('calc-whatsapp-btn');

    if (!typeSelect || !pagesRange) return;

    const basePrices = {
      shopify: 380,
      elementor: 220,
      divi: 240,
      landing: 120,
      custom_wp: 450,
      ecommerce: 550,
      seo_campaign: 280,
      speed: 150
    };

    function recalculate() {
      const type = typeSelect.value;
      const pages = parseInt(pagesRange.value, 10);
      pagesVal.textContent = pages;

      let base = basePrices[type] || 220;
      let pageAdd = Math.max(0, pages - 1) * 35;
      let total = base + pageAdd;

      if (speedCheck && speedCheck.checked) total += 80;
      if (seoCheck && seoCheck.checked) total += 60;
      if (keywordCheck && keywordCheck.checked) total += 90;
      if (offpageCheck && offpageCheck.checked) total += 120;

      let days = Math.min(25, 4 + Math.floor(pages * 0.8) + (total > 450 ? 3 : 0));

      costDisplay.textContent = '$' + total;
      daysDisplay.textContent = days + ' Days';

      const typeLabel = typeSelect.options[typeSelect.selectedIndex].text.split('(')[0].trim();
      let addons = [];
      if (speedCheck && speedCheck.checked) addons.push('Speed 95+');
      if (seoCheck && seoCheck.checked) addons.push('On-Page SEO');
      if (keywordCheck && keywordCheck.checked) addons.push('Keyword Research');
      if (offpageCheck && offpageCheck.checked) addons.push('Off-Page SEO');

      const msg = encodeURIComponent(`Hi Sanjeev! I used your website Cost Estimator.
Project: ${typeLabel}
Pages: ${pages}
Add-ons: ${addons.length ? addons.join(', ') : 'None'}
Est. Budget: $${total} (~₹${(total * 83).toLocaleString('en-IN')})
Timeline: ${days} Days.
Let's discuss!`);

      if (whatsappBtn) {
        whatsappBtn.href = `https://wa.me/37254587576?text=${msg}`;
      }
    }

    typeSelect.addEventListener('change', recalculate);
    pagesRange.addEventListener('input', recalculate);
    if (speedCheck) speedCheck.addEventListener('change', recalculate);
    if (seoCheck) seoCheck.addEventListener('change', recalculate);
    if (keywordCheck) keywordCheck.addEventListener('change', recalculate);
    if (offpageCheck) offpageCheck.addEventListener('change', recalculate);

    recalculate();
  })();
</script>
