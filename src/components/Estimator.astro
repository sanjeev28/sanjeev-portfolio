---
import { getEstimatorPricing } from '../lib/wp.js';

const pricing = await getEstimatorPricing();
---

<section id="estimator" class="py-20 relative z-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Instant Calculation
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Transparent Project Cost Estimator
      </h2>
      <p class="text-slate-400 text-sm max-w-xl mx-auto mt-2">
        Get an immediate ballpark quotation tailored to your web development & SEO requirements.
      </p>
    </div>

    <div class="glass-card rounded-3xl p-8 sm:p-12 border border-slate-800 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center shadow-2xl">
      <div class="lg:col-span-7 space-y-6">
        <div>
          <label for="calc-type" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Select Platform & Project Type</label>
          <select id="calc-type" name="calc-type" aria-label="Select Platform & Project Type" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
            <option value="shopify" data-name="Shopify 2.0 Store Setup & Custom Liquid Theme">Shopify 2.0 Store Setup & Custom Liquid Theme (${pricing.pkg_shopify_liquid})</option>
            <option value="elementor" data-name="Elementor Pro Custom Design & Responsive Build" selected>Elementor Pro Custom Design & Responsive Build (${pricing.pkg_elementor_pro})</option>
            <option value="divi" data-name="Divi Custom Layout & Module Setup">Divi Custom Layout & Module Setup (${pricing.pkg_divi_setup})</option>
            <option value="landing" data-name="High-Conversion Landing Page">High-Conversion Landing Page (${pricing.pkg_landing_page})</option>
            <option value="custom_wp" data-name="Complete Custom WordPress Theme & CMS">Complete Custom WordPress Theme & CMS (${pricing.pkg_custom_wp})</option>
            <option value="ecommerce" data-name="Full WooCommerce E-Commerce Store">Full WooCommerce E-Commerce Store (${pricing.pkg_ecommerce_store})</option>
            <option value="seo_campaign" data-name="Complete SEO Growth Package (On-Page, Off-Page & Keywords)">Complete SEO Growth Package (On-Page, Off-Page & Keywords) (${pricing.pkg_seo_growth})</option>
            <option value="speed" data-name="Speed & Core Web Vitals 95+ Tuning">Speed & Core Web Vitals 95+ Tuning (${pricing.pkg_speed_tuning})</option>
          </select>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label for="calc-pages" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Estimated Number of Pages / Target Keywords</label>
            <span class="text-sm font-bold font-mono text-cyan-400"><span id="calc-pages-val">5</span> Pages</span>
          </div>
          <input type="range" id="calc-pages" name="calc-pages" aria-label="Estimated Number of Pages" min="1" max="15" value="5" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer">
        </div>

        <div class="pt-2 space-y-3">
          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
            <input type="checkbox" id="calc-speed" name="calc-speed" aria-label="95+ PageSpeed & Core Web Vitals Optimization" checked class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
            <span class="text-xs sm:text-sm text-slate-300 flex-1">95+ PageSpeed & Core Web Vitals Optimization</span>
            <span id="label-addon-speed" class="text-xs font-mono text-emerald-400">+${pricing.addon_speed_95}</span>
          </label>

          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
            <input type="checkbox" id="calc-seo" name="calc-seo" aria-label="On-Page Technical SEO & Schema Markup" checked class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
            <span class="text-xs sm:text-sm text-slate-300 flex-1">On-Page Technical SEO & Schema Markup</span>
            <span id="label-addon-seo" class="text-xs font-mono text-emerald-400">+${pricing.addon_onpage_seo}</span>
          </label>

          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
            <input type="checkbox" id="calc-keyword" name="calc-keyword" aria-label="In-Depth Keyword Research & Competitor Gap Analysis" class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
            <span class="text-xs sm:text-sm text-slate-300 flex-1">In-Depth Keyword Research & Competitor Gap Analysis</span>
            <span id="label-addon-keyword" class="text-xs font-mono text-emerald-400">+${pricing.addon_keyword_research}</span>
          </label>

          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
            <input type="checkbox" id="calc-offpage" name="calc-offpage" aria-label="Off-Page SEO Backlink Outreach & Authority Citations" class="w-4 h-4 rounded text-indigo-600 bg-slate-800 border-slate-700">
            <span class="text-xs sm:text-sm text-slate-300 flex-1">Off-Page SEO Backlink Outreach & Authority Citations</span>
            <span id="label-addon-offpage" class="text-xs font-mono text-emerald-400">+${pricing.addon_offpage_seo}</span>
          </label>
        </div>
      </div>

      <div class="lg:col-span-5 bg-gradient-to-tr from-slate-900 via-indigo-950/60 to-slate-900 p-8 rounded-2xl border border-indigo-500/30 text-center">
        <span class="px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-mono inline-block mb-3">Estimated Investment</span>
        <div id="calc-cost" class="text-5xl font-extrabold text-white font-mono tracking-tight mb-1">$480</div>
        <span class="text-xs text-slate-400 mb-6 block">One-time transparent quote</span>

        <div class="grid grid-cols-2 gap-3 mb-6 text-left">
          <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
            <span class="text-[10px] font-mono text-slate-500 block uppercase">Est. Delivery</span>
            <span id="calc-days" class="text-sm font-bold text-white font-mono">7 Days</span>
          </div>
          <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
            <span class="text-[10px] font-mono text-slate-500 block uppercase">Support</span>
            <span class="text-sm font-bold text-emerald-400 font-mono">30 Days Free</span>
          </div>
        </div>

        <a id="calc-whatsapp-btn" href={`https://wa.me/${(pricing.whatsapp_number || '+37254587576').replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener" class="w-full py-3.5 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/25 transition-all">
          <i class="fa-brands fa-whatsapp text-lg"></i> Lock In This Quote
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ initialPricing: pricing }}>
  (function initEstimator() {
    let p = initialPricing || {};

    const typeSelect = document.getElementById('calc-type');
    const pagesRange = document.getElementById('calc-pages');
    const pagesVal = document.getElementById('calc-pages-val');
    const speedCheck = document.getElementById('calc-speed');
    const seoCheck = document.getElementById('calc-seo');
    const keywordCheck = document.getElementById('calc-keyword');
    const offpageCheck = document.getElementById('calc-offpage');
    const costDisplay = document.getElementById('calc-cost');
    const daysDisplay = document.getElementById('calc-days');
    const whatsappBtn = document.getElementById('calc-whatsapp-btn');

    if (!typeSelect || !pagesRange) return;

    function getBasePrice(type) {
      if (type === 'shopify') return Number(p.pkg_shopify_liquid) || 380;
      if (type === 'elementor') return Number(p.pkg_elementor_pro) || 220;
      if (type === 'divi') return Number(p.pkg_divi_setup) || 240;
      if (type === 'landing') return Number(p.pkg_landing_page) || 120;
      if (type === 'custom_wp') return Number(p.pkg_custom_wp) || 450;
      if (type === 'ecommerce') return Number(p.pkg_ecommerce_store) || 550;
      if (type === 'seo_campaign') return Number(p.pkg_seo_growth) || 280;
      if (type === 'speed') return Number(p.pkg_speed_tuning) || 150;
      return 220;
    }

    function updateOptionLabels() {
      for (let i = 0; i < typeSelect.options.length; i++) {
        const opt = typeSelect.options[i];
        const baseName = opt.getAttribute('data-name') || opt.text.split('(')[0].trim();
        const price = getBasePrice(opt.value);
        opt.text = `${baseName} ($${price})`;
      }
      const speedLbl = document.getElementById('label-addon-speed');
      if (speedLbl) speedLbl.textContent = `+$${p.addon_speed_95 || 80}`;
      const seoLbl = document.getElementById('label-addon-seo');
      if (seoLbl) seoLbl.textContent = `+$${p.addon_onpage_seo || 60}`;
      const keyLbl = document.getElementById('label-addon-keyword');
      if (keyLbl) keyLbl.textContent = `+$${p.addon_keyword_research || 90}`;
      const offLbl = document.getElementById('label-addon-offpage');
      if (offLbl) offLbl.textContent = `+$${p.addon_offpage_seo || 120}`;
    }

    function recalculate() {
      const type = typeSelect.value;
      const pages = parseInt(pagesRange.value, 10);
      if (pagesVal) pagesVal.textContent = pages;

      let base = getBasePrice(type);
      let pageRate = Number(p.page_rate) || 35;
      let pageAdd = Math.max(0, pages - 1) * pageRate;
      let total = base + pageAdd;

      if (speedCheck && speedCheck.checked) total += (Number(p.addon_speed_95) || 80);
      if (seoCheck && seoCheck.checked) total += (Number(p.addon_onpage_seo) || 60);
      if (keywordCheck && keywordCheck.checked) total += (Number(p.addon_keyword_research) || 90);
      if (offpageCheck && offpageCheck.checked) total += (Number(p.addon_offpage_seo) || 120);

      let days = Math.min(25, 4 + Math.floor(pages * 0.8) + (total > 450 ? 3 : 0));

      if (costDisplay) costDisplay.textContent = '$' + total;
      if (daysDisplay) daysDisplay.textContent = days + ' Days';

      const typeLabel = typeSelect.options[typeSelect.selectedIndex].text.split('(')[0].trim();
      let addons = [];
      if (speedCheck && speedCheck.checked) addons.push('Speed 95+');
      if (seoCheck && seoCheck.checked) addons.push('On-Page SEO');
      if (keywordCheck && keywordCheck.checked) addons.push('Keyword Research');
      if (offpageCheck && offpageCheck.checked) addons.push('Off-Page SEO');

      const rawNumber = (p.whatsapp_number || '+37254587576').replace(/[^0-9]/g, '');
      const msg = encodeURIComponent(`Hi Sanjeev! I used your website Cost Estimator.
Project: ${typeLabel}
Pages: ${pages}
Add-ons: ${addons.length ? addons.join(', ') : 'None'}
Est. Budget: $${total} (~₹${(total * 83).toLocaleString('en-IN')})
Timeline: ${days} Days.
Let's discuss!`);

      if (whatsappBtn) {
        whatsappBtn.href = `https://wa.me/${rawNumber}?text=${msg}`;
      }
    }

    typeSelect.addEventListener('change', recalculate);
    pagesRange.addEventListener('input', recalculate);
    if (speedCheck) speedCheck.addEventListener('change', recalculate);
    if (seoCheck) seoCheck.addEventListener('change', recalculate);
    if (keywordCheck) keywordCheck.addEventListener('change', recalculate);
    if (offpageCheck) offpageCheck.addEventListener('change', recalculate);

    recalculate();

    // Live Client-Side Sync: Fetch from WordPress REST API to ensure 100% fresh prices
    fetch('https://cms.sanjeevchoudhary.com/wp-json/sanjeev/v1/estimator-pricing')
      .then(res => res.json())
      .then(livePricing => {
        if (livePricing && livePricing.pkg_shopify_liquid) {
          p = livePricing;
          updateOptionLabels();
          recalculate();
        }
      })
      .catch(() => {});
  })();
</script>
