---
import Layout from '../layouts/Layout.astro';
import Estimator from '../components/Estimator.astro';
import Workflow from '../components/Workflow.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
  title="Instant Cost Estimator — Sanjeev Choudhary"
  description="Calculate your transparent project quotation for WordPress, Elementor Pro, and Shopify 2.0 stores with instant WhatsApp lock-in."
>
  <div class="relative pt-28 pb-12 text-center border-b border-slate-800/80 bg-gradient-to-b from-indigo-950/20 to-transparent">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
      Instant Calculation
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
      Transparent Project Cost Estimator
    </h1>
    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto">
      Zero hidden fees. Clear milestone schedules and guaranteed 30 days of post-launch warranty.
    </p>
  </div>

  <Estimator />
  <Workflow />
  <FaqAccordion />
  <CtaBanner />
</Layout>
