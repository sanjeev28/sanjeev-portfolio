---
import Layout from '../layouts/Layout.astro';
import AboutStory from '../components/AboutStory.astro';
import Stats from '../components/Stats.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
  title="About Me — Sanjeev Choudhary | Senior WordPress, PHP & Shopify Engineer"
  description="Learn more about Sanjeev Choudhary's 12+ years experience, including 2 years at Nextpage IT Solutions and 650+ websites delivered globally."
>
  <div class="relative pt-28 pb-12 text-center border-b border-slate-800/80 bg-gradient-to-b from-indigo-950/20 to-transparent">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
      About Me
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
      Crafting High-Speed Web Realities Since 2016
    </h1>
    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto">
      From Nextpage IT Solutions to building 650+ websites for international clients across WordPress, Elementor, Divi, and Shopify.
    </p>
  </div>

  <AboutStory />
  <Stats />
  <CtaBanner />
</Layout>
